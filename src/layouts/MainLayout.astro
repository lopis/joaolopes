---
const { ...props } = Astro.props;
const title = Astro.props.title || "jlopes.dev";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
  <script
    defer
    data-domain="jlopes.dev"
    src="https://p.jlopes.dev/js/script.outbound-links.js"></script>
</html>

<style is:global>
  :root {
    --color-bg: #f7f3ec;
    --color-text: #272016;
    --color-text-secondary: #78705E;
    --color-border: #E0D8CC;
    --color-accent: #9B3E2A;
    --color-accent-hover: #7A2E1A;
    --color-accent-underline: #C05A3A;
  }

  *:focus-visible {
    outline: 2px solid var(--color-accent);
  }

  @font-face {
    font-family: 'Fraunces';
    src: url('../assets/fonts/Fraunces_72pt-Regular.ttf') format('truetype');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Inconsolata';
    src: url('../assets/fonts/Inconsolata-VariableFont.ttf') format('truetype');
    font-style: normal;
    font-display: swap;
  }

  html {
    background: var(--color-bg);
  }

  html,
  body {
    margin: 0;
    padding-bottom: 5em;
  }

  body {
    min-height: 100vh;
    max-width: 720px;
    box-sizing: border-box;
    font-family: 'Inconsolata', monospace;
    padding: 1em 3em;
    margin: auto;
    font-size: 16px;
    color: var(--color-text);
    font-weight: 350;

    @media screen and (max-width: 720px) {
      padding: 5px;
    }
  }

  strong {
    font-weight: 750;
  }

  h1 {
    font-size: 1em;
    font-weight: 700;
    margin-bottom: 0;
    margin-top: 2em;
    font-family: 'Fraunces', serif;
  }

  h2 {
    font-weight: 400;
    font-size: 0.9em;
    margin: 2em auto 1em;
    color: var(--color-text-secondary);
    text-transform: uppercase;
  }

  a,
  a:visited {
    color: var(--color-accent);

    &:hover {
      color: var(--color-accent-hover);
    }
  }

  p {
    max-width: 80ch;
    img {
      max-width: 100%;
    }
  }

  pre {
    padding: 2em;
    border-radius: 2px;
    white-space: break-spaces;
    background: var(--color-text) !important;
  }

  button {
    background: var(--color-accent);
    color: var(--color-bg);
    border: none;
    padding: 0.5em 1em;
    border-radius: 2px;
    font-size: 1rem;
  }

  button:hover {
    background: var(--color-accent-hover);
  }

  button:active {
    background: var(--color-accent-underline);
  }

  button:focus {
    outline: 2px solid var(--color-accent-hover);
    outline-offset: 2px;
  }
</style>
