---
import MainLayout from "./MainLayout.astro";

const { frontmatter } = Astro.props;
const { title, website, repository, date, embed } = frontmatter;

const displayDate = new Date(date).toLocaleDateString();
---

<MainLayout title={title}>
  <h1>
    <a class="goback" href="/">&#60;</a>
    {title}
  </h1>
  <nav>
    {displayDate} | <a href={website}>Original release</a> | <a
      href={repository}>Source</a
    >
  </nav>
  <main>
    <div class="gameWrapper">
      <iframe src={embed}></iframe>
      <a href={embed} target="_blank">
        <span class="fullscreen">⛶ Fullscreen</span>
      </a>
    </div>
  </main>
  <p>
    <slot />
  </p>
</MainLayout>

<style>
  iframe {
    width: 100%;
    aspect-ratio: 4/3;
    border: 1px solid var(--black);
    border-radius: 2px;
  }

  h1 {
    position: relative;
  }

  .gameWrapper {
    position: relative;
    margin: 1em -4vw;
  }

  .fullscreen {
    display: inline-block;
    padding: 5px 10px;
    background: var(--light);
    color: var(--white);
    border-radius: 2px;
    font-weight: bold;
    cursor: pointer;
    float: right;

    &:hover {
      background: var(--highlight);
    }
  }

  .goback {
    text-decoration: none;
    position: absolute;
    left: -60px;
    font-weight: bold;
    display: inline-block;
    height: 48px;
    width: 48px;
    text-align: center;
    font-size: 1.3em;
    line-height: 1em;
    border-radius: 2px;

    &:hover {
      background: var(--highlight);
      color: white;
    }
  }
</style>
