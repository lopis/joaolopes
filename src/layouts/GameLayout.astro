---
import MainLayout from "./MainLayout.astro";

const { frontmatter } = Astro.props;
const { title, website, repository, date, embed } = frontmatter;

const displayDate = new Date(date).toLocaleDateString();
---

<MainLayout title={title}>
  <h1>
    {title}
  </h1>
  <nav>
    {displayDate} | <a href={website}>Original release</a> | <a
      href={repository}>Source</a
    >
  </nav>
  <main>
    <div class="gameWrapper">
      <iframe src={embed}></iframe>
      <a href={embed} target="_blank">
        <span class="fullscreen">⛶ Fullscreen</span>
      </a>
    </div>
  </main>
  <p>
    <slot />
  </p>
</MainLayout>

<style>
  iframe {
    width: 100%;
    aspect-ratio: 4/3;
    border: 1px solid var(--color-text);
    border-radius: 2px;
  }

  h1 {
    position: relative;
  }

  .gameWrapper {
    position: relative;
    margin: 1em -4vw;
  }

  .fullscreen {
    display: inline-block;
    padding: 5px 10px;
    background: var(--color-accent);
    color: var(--color-bg);
    border-radius: 2px;
    font-weight: bold;
    cursor: pointer;
    float: right;

    &:hover {
      background: var(--color-accent-hover);
    }
  }
</style>
