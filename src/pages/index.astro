---
import MainLayout from "@layouts/MainLayout.astro";
import { Image } from "astro:assets";
import Github from '../assets/github.png';

interface Post {
  frontmatter: {
    date: string,
    title: string,
    thumbnail: string,
  },
  url: string,
}

function sortByDate(arr: Post[]) {
  return arr.sort(
  (a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime(),
  );
}

const posts = sortByDate(Object.values(
import.meta.glob("./posts/*.md", { eager: true }),
));
const projects = sortByDate(Object.values(
import.meta.glob("./projects/*.md", { eager: true }),
));
const games = sortByDate(Object.values(
import.meta.glob("./games/*.md", { eager: true }),
));

const formatDate = (date: string) => new Date(date).toLocaleDateString();
---

<MainLayout>
  <h1>jlopes.dev</h1>
  <section class="links">
    <p>
      <span class="icon">💼</span>
      Software Engineer
    </p>
    <p>
      <span class="icon">📌</span>
      Berlin, Germany
    </p>
    <p>
      <Image class="icon" src={Github} alt="gmail icon" />
      <a href="https://github.com/lopis" target="_blank">Github</a>
    </p>
    <p>
      <span class="icon">📝</span>
      <a href="cv" target="_blank">Resume</a>
    </p>
  </section>
  <section>
    <h2>Games</h2>
    <ul class="games list">
      {
        games.map((game) => (
          <li>
            <a class="game card" href={game.url}>
              <Image
              src={game.frontmatter.thumbnail}
              alt=""
              height="88"
              width="140"
              />
              <span class="label">{game.frontmatter.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
  <section>
    <h2>Projects</h2>
    <ul class="list">
      {
        projects.map((project) => (
        <li>
          <a href={project.url}>{project.frontmatter.title}</a>
        </li>
        ))
      }
    </ul>
  </section>
  <section>
    <h2>Posts</h2>
    <ul class="list">
      {
        posts.map((post) => (
          <a class="post card" href={post.url}>
            <li>
                <div class="post-date">
                  {formatDate(post.frontmatter.date)}
                </div>
                <div>
                  {post.frontmatter.title}
                </div>
            </li>
          </a>
        ))
      }
    </ul>
  </section>
</MainLayout>

<style>
  .list {
    list-style: none;
    padding: 0;
    line-height: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 1em;
    justify-content: center;
  }

  .card {
    padding: 5px;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #ffe4d8aa;
    border-radius: 8px;
    overflow: hidden;
    color: var(--black);
    justify-content: stretch;
    box-shadow:
      0px 2px 10px 0px #a1134933,
      0px -2px 10px 0px rgba(255,255,255, 0.5),
      0px 10px 15px -15px rgba(255,255,255, 1) inset;

  }

  a.card:hover {
    background-color: #ffffff55;
  }

  .links {
    display: flex;
    gap: 1em;
    font-size: 80%;
  }

  .links img {
    width: 1.2em;
    height: 1.2em;
    margin: auto;
  }
  
  .game {
    width: 140px;
    height: 100%;
    text-align: center;

    img {
      border-radius: 6px;
      overflow: hidden;
    }

    .label {
      flex-grow: 1;
      align-content: center;
      text-align: center;
    }
  }

  .post {
    flex-basis: 40%;
    align-items: start;
    color: var(--black);
    text-decoration: none;
  }

  .post-date {
    font-size: 80%;
    color: var(--light);
  }


  @media (max-width: 600px) {
    .links .icon {
      display: block;
    }

    .links p {
      text-align: center;
      flex-grow: 1;
      flex-basis: 25%;
    }

    .post {
      flex-basis: 100%;
    }
  }
</style>
