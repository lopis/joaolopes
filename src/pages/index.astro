---
import MainLayout from "@layouts/MainLayout.astro";
import { Image } from "astro:assets";
import Github from '../assets/github.png';
import IconPC from '../assets/pc.svg';
import IconMobile from '../assets/phone.svg';

interface Post {
  frontmatter: {
    date: string,
    title: string,
    thumbnail: string,
  },
  url: string,
}

interface Game extends Post {
  frontmatter: Post['frontmatter'] & {
    platform: ('pc' | 'mobile')[],
  }
}

function sortByDate(arr: Post[]) {
  return arr.sort(
  (a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime(),
  );
}

const posts = sortByDate(Object.values(
import.meta.glob("./posts/*.md", { eager: true }),
));
const projects = sortByDate(Object.values(
import.meta.glob("./projects/*.md", { eager: true }),
));
const games = sortByDate(Object.values(
import.meta.glob("./games/*.md", { eager: true }),
)) as Game[];

const formatDate = (date: string) => new Date(date).toLocaleDateString();
---

<MainLayout>
  <h1>João Lopes</h1>
  <div class="sub-header">Software Engineer — Copenhagen, Denmark</div>
  <section class="links">
    <a href="https://github.com/lopis" target="_blank">Github</a>
    <a href="https://github.com/lopis" target="_blank">Dev.to</a>
    <a href="cv" target="_blank">Resume</a>
  </section>
  <section>
    <h2>Games</h2>
    <ul class="games">
      {
        games.map((game: Game) => (
          <li>
            <a class="game card" href={game.url}>
              <Image
              src={game.frontmatter.thumbnail}
              alt=""
              height="88"
              width="140"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </section>
  <section>
    <h2>Projects</h2>
    <ul class="list">
      {
        projects.map((project) => (
          <a href={project.url}>
            <li class="project">
            {project.frontmatter.title}
            </li>
          </a>
        ))
      }
    </ul>
  </section>
  <section>
    <h2>Posts</h2>
    <ul class="list">
      {
        posts.map((post) => (
          <a href={post.url}>
            <li class="post">
                <div>
                  {post.frontmatter.title}
                </div>
                <div class="post-date">
                  {formatDate(post.frontmatter.date)}
                </div>
            </li>
          </a>
        ))
      }
    </ul>
  </section>
</MainLayout>

<style>
  .sub-header {
    color: var(--color-text-secondary);
  }

  .list {
    list-style: none;
    padding: 0;
    margin: 0;

    @media (max-width: 720px) {
      display: block;
    }
  }

  .list li {
    display: flex;
    justify-content: space-between;
    width: 100%;
    align-items: center;
  }

  .list a {
    text-decoration: none;
    color: var(--color-text);
  }

  .card {
    padding: 5px;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--white);
    border-radius: 2px;
    overflow: hidden;
    justify-content: stretch;
    box-shadow:
      0px 10px 15px -15px rgba(255,255,255, 1) inset,
      0 0 1px 0 var(--color-text);

  }

  a.card:hover {
    background-color: var(--light);
  }

  .links {
    display: flex;
    gap: 1em;
    margin-top: 0.5em;
    text-underline-offset: 4px;
  }

  .links img {
    width: 1.2em;
    height: 1.2em;
    margin: auto;
  }

  .games {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1em;
    justify-content: center;

    @media (max-width: 720px) {
      gap: 0.5em;
    }
  }
  
  .game {
    position: relative;
    height: 100%;
    text-align: center;
    text-decoration: none;
    padding: 0;
    overflow: hidden;

    img {
      overflow: hidden;
      max-width: 40vw;
      height: auto;
    }
  }

  .post, .project {
    align-items: start;
    padding: 0.4em 0;
    border-bottom: 1px solid var(--color-border);
  }

  .post-date {
    font-size: 80%;
    color: var(--color-text-secondary);
  }


  @media (max-width: 600px) {
    .links .icon {
      display: block;
    }

    .links p {
      text-align: center;
      flex-grow: 1;
      flex-basis: 25%;
    }

    .post {
      flex-basis: 100%;
    }
  }
</style>
