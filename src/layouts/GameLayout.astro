---
import MainLayout from "./MainLayout.astro";

const { frontmatter } = Astro.props;
const { title, website, repository, date, embed } = frontmatter;

const displayDate = new Date(date).toLocaleDateString();
---

<MainLayout title={title}>
  <h1>
    <a class="goback" href="/">&#60;</a>
    {title}
  </h1>
  <nav>
    {displayDate} | <a href={website}>Original release</a> | <a
      href={repository}>Source</a
    >
  </nav>
  <main>
    <iframe src={embed}></iframe>
  </main>
  <p>
    <slot />
  </p>
</MainLayout>

<style>
  iframe {
    width: calc(100% + 8vw);
    aspect-ratio: 4/3;
    margin: 1em -4vw;
  }

  h1 {
    position: relative;
  }

  .goback {
    text-decoration: none;
    position: absolute;
    left: -60px;
    font-weight: bold;
    display: inline-block;
    height: 48px;
    width: 48px;
    text-align: center;
    font-size: 1.3em;
    line-height: 1em;
    border-radius: 5px;

    &:hover {
      background: var(--highlight);
      color: white;
    }
  }
</style>
