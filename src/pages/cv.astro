---
import { Image } from 'astro:assets';
import Me from '../data/about/me.md';
import Photo from '../assets/profile.png';
import MainLayout from "@layouts/MainLayout.astro";

const masters = await Astro.glob('../data/about/masters.md');
const MastersPage = Object.values(masters)[0];
const jobs = await Astro.glob('../data/career/*.md');
const other = await Astro.glob('../data/other/*.md');

const sortedJobs = Object.values(jobs).sort((a, b) => {
  return new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime();
});
const sortedOther = Object.values(other).sort((a, b) => {
  return new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime();
});

---
<MainLayout>
  <aside class="about">
    <div class="details">
      <div class="name">
        <Image class="photo" src={Photo} alt="my photo" />
        <h1><strong>João Lopes</strong></h1>
      </div>
      <div class="other-details">
        <p class="email">
          <span>joaopclopes</span>
        </p>
        <p>
          Software Engineer
        </p>
        <p>
          Copenhagen, Denmark
        </p>
        <p>
          <a href="https://github.com/lopis" target="_blank">Github</a>
          <a href="https://dev.to/mrlopis" target="_blank">Dev.to</a>
          <a href="https://jlopes.dev/" target="_blank">My Games</a>
        </p>
        <p>
          Languages
          <ul>
            <li>Portuguese (native)</li>
            <li>English (fluent)</li>
            <li>Spanish (basic)</li>
            <li>German (basic)</li>
          </ul>
        </p>
      </div>
    </div>
    <div class="me">
      <Me/>
    </div>
  </aside>

  <main>
    <section>
      <h2>Career</h2>

      {sortedJobs.map((job) => (
        <div class="job">
          <p class="period">{job.frontmatter.period}</p>
          <h3>{job.frontmatter.title}</h3>
          <p>
            <a href={job.frontmatter.website} target="_blank">{job.frontmatter.org}</a>
            &mdash;
            {job.frontmatter.location}
          </p>
          <div class="tags">{job.frontmatter.tags.map((tag: string) => (
            <span class="tag">{tag}</span>
          ))}</div>

          <job.Content />
        </div>
      ))}
    </section>
  </main>

  <div class="bottom">
    <section>
      <h2>Other</h2>

      {sortedOther.map((job) => (
        <div class="job">
          <p class="period">{job.frontmatter.period}</p>
          <h3>{job.frontmatter.title}</h3>
          <p>
            <a href={job.frontmatter.website} target="_blank">{job.frontmatter.org}</a>
            &mdash;
            {job.frontmatter.location}
          </p>
          <div class="tags">{job.frontmatter.tags.map((tag: string) => (
            <span class="tag">{tag}</span>
          ))}</div>

          <job.Content />
        </div>
      ))}
    </section>

    <section>
      <h2>Education</h2>

      <div class="job">
        <p class="period">{MastersPage.frontmatter.period}</p>
          <h3>{MastersPage.frontmatter.title}</h3>
          <p>
            <a href={MastersPage.frontmatter.website} target="_blank">{MastersPage.frontmatter.org}</a>
            &mdash;
            {MastersPage.frontmatter.location}
          </p>
        <MastersPage.Content />
      </div>
    </section>
  </div>

  <p class="print-action">
    <button style="display: block; margin: auto" onclick="window.print()">Get print version</button>
  </p>
</MainLayout>

<style is:global>
  h1 {
    margin-top: 1em;
    font-size: 1.5em;
    text-align: center;
  }

  h3, p, .tags {
    margin: 0.2em;
    font-size: 1em;
  }

  .me {
    text-align: justify;
    text-indent: 3em;

  }

  .me p {
    margin-bottom: 0.5em;
  }

  ul {
    padding-left: 1em;
    margin: 0;
    max-width: 80ch;
  }

  .tag {
    display: inline-block;
    background: var(--color-accent);
    color: var(--color-bg);
    padding: 0.1em 0.4em;
    margin-right: 0.4em;
    border-radius: 0.25em;
    font-size: 0.7em;
    font-weight: 600;
  }

  .period {
    color: var(--color-accent);
    font-size: 0.8em;
    float: right;
  }

  .job {
    border: solid var(--color-border);
    border-width: 1px 0 0 0;
    padding: 1em 0.2em;
    page-break-inside: avoid;
  }

  .about {
    display: flex;
  }

  .photo {
    width: 150px;
    height: 150px;
    border-radius: 5%;
    margin: 0 1em;
  }

  .icon {
    display: inline-flex;
    justify-content: center;
    height: 1rem;
    width: 1rem;
    font-size: 0.9em;
    background: white;
    border-radius: 20%;
    padding: 1px;
    position: absolute;
    align-items: center;
    left: -20px;
  }

  .details {
    font-size: 0.8rem;
    border: solid var(--color-border);
    border-width: 0 1px 0 0;
    margin-right: 0.5rem;
  }

  .details p {
    margin-bottom: 0.5em;
  }

  .details h2 {
    text-align: center;
    margin: 0;
  }

  .other-details {
    position: relative;
  }

  .email {
    display: none;
  }

  @media screen and (max-width: 600px) {
    .about {
      display: flex;
      flex-direction: column;
    }

    .details {
      border: none;
      border-width: 0 1px 0 0;
      margin: 0;
      display: flex;
    }

    .other-details {
      flex-grow: 1;
      margin-left: 1em;
    }

    .me {
      text-indent: 1.5em;
    }
  }

  @media print {
    html {
      margin: 0;
      padding: 0;
    }

    body {
      padding: 0;
      font-size: 8.5pt;
      display: grid;
      gap: 20px;
      min-height: unset;
      grid-template-columns: 7fr 3fr;
    }

    aside {
      flex-basis: 30%;
      flex-shrink: 0;
    }

    .bottom {
      order: 2;
      grid-column: 1 / span 2;
      display: grid;
      grid-template-columns: 7fr 3fr;
      gap: 20px;
    }

    .details {
      border: none;
    }

    .about {
      order: 1;
      display: flex;
      flex-direction: column;
    }

    .photo {
      height: 80px;
      width: 80px;
    }

    .name {
      text-align: center;
    }

    .tag {
      -webkit-print-color-adjust: exact !important;   /* Chrome, Safari 6 – 15.3, Edge */
      color-adjust: exact !important;                 /* Firefox 48 – 96 */
      print-color-adjust: exact !important;           /* Firefox 97+, Safari 15.4+ */
    }

    .job {
      border-color: var(--color-border);
      padding: 0.5em 0;
    }

    .email {
      display: flex;
    }

    .email::after {
      display: inline-flex;
      content: '@gmail.com';
    }

    .print-action {
      display: none;
    }
  }
</style>
