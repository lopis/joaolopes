---
import { Image } from "astro:assets";
import MainLayout from "./MainLayout.astro";

const { frontmatter } = Astro.props;
const { title, original_link, website, cover_image, date } = frontmatter;

const displayDate = new Date(date).toLocaleDateString();
---

<MainLayout title={title}>
  <a class="goback" href="/">&#60; Return to Index</a>
  <h1>
    {title}
  </h1>
  <nav>
    {displayDate}
    {
      original_link && (
        <>
          | <a href={original_link}>Original post</a>
        </>
      )
    }
    {
      website && (
        <>
          | <a href={website}>Website</a>
        </>
      )
    }
  </nav>
  {
    cover_image ? (
      <Image inferSize={true} class="cover" src={cover_image} alt="" />
    ) : (
      <div class="cover default" />
    )
  }
  <main class="post">
    <slot />
  </main>
</MainLayout>

<style>
  .cover {
    width: calc(100% + 10vw);
    height: 25vw;
    object-fit: cover;
    margin: 2vw -5vw;
    border-bottom: 3px solid var(--color-accent);
  }

  .cover.default {
    border: none;
    background-color: var(--color-bg);
    opacity: 0.6;
    background-image: linear-gradient(
        30deg,
        #e44800 12%,
        transparent 12.5%,
        transparent 87%,
        #e44800 87.5%,
        #e44800
      ),
      linear-gradient(
        150deg,
        #e44800 12%,
        transparent 12.5%,
        transparent 87%,
        #e44800 87.5%,
        #e44800
      ),
      linear-gradient(
        30deg,
        #e44800 12%,
        transparent 12.5%,
        transparent 87%,
        #e44800 87.5%,
        #e44800
      ),
      linear-gradient(
        150deg,
        #e44800 12%,
        transparent 12.5%,
        transparent 87%,
        #e44800 87.5%,
        #e44800
      ),
      linear-gradient(
        60deg,
        #e4480077 25%,
        transparent 25.5%,
        transparent 75%,
        #e4480077 75%,
        #e4480077
      ),
      linear-gradient(
        60deg,
        #e4480077 25%,
        transparent 25.5%,
        transparent 75%,
        #e4480077 75%,
        #e4480077
      );
    background-size: 80px 140px;
    background-position:
      0 0,
      0 0,
      40px 70px,
      40px 70px,
      0 0,
      40px 70px;
  }

  h1 {
    font-size: 1.1em;
    position: relative;
  }

  nav {
    color: var(--color-text-secondary)
  }
</style>

<style is:global>
  .post {
    h2, h3 {
      font-size: 1.1em;
    }
  }
</style>
