---
import MainLayout from "@layouts/MainLayout.astro";
import { Image } from "astro:assets";
import Github from '../assets/github.png';

interface Post {
  frontmatter: {
    date: string,
    title: string,
    thumbnail: string,
  },
  url: string,
}

function sortByDate(arr: Post[]) {
  return arr.sort(
  (a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime(),
  );
}

const posts = sortByDate(Object.values(
import.meta.glob("./posts/*.md", { eager: true }),
));
const projects = sortByDate(Object.values(
import.meta.glob("./projects/*.md", { eager: true }),
));
const games = sortByDate(Object.values(
import.meta.glob("./games/*.md", { eager: true }),
));

const formatDate = (date: string) => new Date(date).toLocaleDateString();
---

<MainLayout>
  <h1>jlopes.dev</h1>
  <section class="links">
    <p>
      <span class="icon">💼</span>
      Software Engineer
    </p>
    <p>
      <span class="icon">📌</span>
      Berlin, Germany
    </p>
    <p>
      <Image class="icon" src={Github} alt="gmail icon" />
      <a href="https://github.com/jlopes" target="_blank">Github</a>
    </p>
    <p>
      <span class="icon">📝</span>
      <a href="cv" target="_blank">Resume</a>
    </p>
  </section>
  <section>
    <h2>Games</h2>
    <ul class="games">
      {
        games.map((game) => (
        <li>
          <a class="game" href={game.url}>
            <Image
            src={game.frontmatter.thumbnail}
            alt=""
            height="88"
            width="140"
            />
            <span>{game.frontmatter.title}</span>
          </a>
        </li>
        ))
      }
    </ul>
  </section>
  <section>
    <h2>Projects</h2>
    <ul class="list">
      {
        projects.map((project) => (
        <li>
          <a href={project.url}>{project.frontmatter.title}</a>
        </li>
        ))
      }
    </ul>
  </section>
  <section>
    <h2>Posts</h2>
    <ul class="list">
      {
        posts.map((post) => (
        <li>
          {formatDate(post.frontmatter.date)} ·
          <a href={post.url}>{post.frontmatter.title}</a>
        </li>
        ))
      }
    </ul>
  </section>
</MainLayout>

<style>
  .list {
    list-style: none;
    padding-left: 1em;
    border-left: 5px solid var(--highlight);
    line-height: 2;
  }

  .links {
    display: flex;
    gap: 1em;
    font-size: 80%;
  }

  .links img {
    width: 1.2em;
    height: 1.2em;
    margin: auto;
  }

  @media (max-width: 600px) {
    .links .icon {
      display: block;
    }

    .links p {
      text-align: center;
      flex-grow: 1;
      flex-basis: 25%;
    }
  }
  
  .games {
    display: flex;
    flex-wrap: wrap;
    gap: 1em;
    list-style: none;
    padding-left: 0;
    
    .game {
      padding: 0;
      width: 140px;
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      background: var(--black);
      border-radius: 5px;
      overflow: hidden;
      color: var(--white);
      justify-content: stretch;
      box-shadow: 0 0 0px 1px var(--black);
    }
    
    a,
    a span {
      color: var(--white);
      text-decoration: none;
      padding: 5px;
      text-align: center;
    }
  }
</style>
