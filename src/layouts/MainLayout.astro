---
const { ...props } = Astro.props;
const title = Astro.props.title || "jlopes.dev";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
  <script
    defer
    data-domain="jlopes.dev"
    src="https://p.jlopes.dev/js/script.outbound-links.js"></script>
</html>

<style is:global>
  :root {
    --black: #1a000a;
    --white: #ffe4d8;
    --light: #a34a59;
    --highlight: #660429;
    --medium: #99073f;
  }

  html,
  body {
    margin: 0;
  }

  html {
    --background1: #100006;
    --background2: #10000677;
    background-color: #3b0017;
    background-image: linear-gradient(
        30deg,
        var(--background1) 12%,
        transparent 12.5%,
        transparent 87%,
        var(--background1) 87.5%,
        var(--background1)
      ),
      linear-gradient(
        150deg,
        var(--background1) 12%,
        transparent 12.5%,
        transparent 87%,
        var(--background1) 87.5%,
        var(--background1)
      ),
      linear-gradient(
        30deg,
        var(--background1) 12%,
        transparent 12.5%,
        transparent 87%,
        var(--background1) 87.5%,
        var(--background1)
      ),
      linear-gradient(
        150deg,
        var(--background1) 12%,
        transparent 12.5%,
        transparent 87%,
        var(--background1) 87.5%,
        var(--background1)
      ),
      linear-gradient(
        60deg,
        var(--background2) 25%,
        transparent 25.5%,
        transparent 75%,
        var(--background2) 75%,
        var(--background2)
      ),
      linear-gradient(
        60deg,
        var(--background2) 25%,
        transparent 25.5%,
        transparent 75%,
        var(--background2) 75%,
        var(--background2)
      );
    background-size: 20px 35px;
    background-position:
      0 0,
      0 0,
      10px 18px,
      10px 18px,
      0 0,
      10px 18px;
    color: var(--black);
  }

  body {
    min-height: 100vh;
    max-width: 1100px;
    box-sizing: border-box;
    background-color: var(--white);
    font-family: system-ui, "Segoe UI", Roboto, Helvetica, Arial, sans-serif,
      "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol";
    padding: 1em 5vw;
    margin: auto;
    font-size: 18px;
  }

  h1 {
    font-weight: normal;
    font-family: serif;
  }

  a,
  a:visited {
    color: var(--medium);
  }

  p {
    max-width: 80ch;
    img {
      max-width: 100%;
    }
  }

  pre {
    padding: 2em;
    border-radius: 5px;
    white-space: break-spaces;
    background: var(--black) !important;
  }
</style>
